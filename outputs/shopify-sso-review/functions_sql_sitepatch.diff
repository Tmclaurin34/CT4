+"""Shopify non-embedded release: goclicktide.com dashboard changes (index.html).
+
+Usage: python3 -I nonembedded_index_patch.py INDEX_HTML [--check]
+Applies anchored replacements; every anchor must match exactly once (or the patch is already
+applied), otherwise nothing is written. Safe to re-run.
+
+What it changes, for Shopify merchants only:
+ 1. A store's own Clicktide account (made at install, app_metadata.shopify_shop) arriving with a
+    sign-in link from the Shopify admin goes straight to the dashboard, never the onboarding
+    wizard (which lists other POS systems), and gets no welcome e-mail about POS connections.
+ 2. The sign-in confirmation names the Shopify store instead of an internal e-mail address.
+ 3. Any account with a Shopify store (or a pending store link) opens the dashboard, unpaid or
+    not; "Finish setup" / "Billing required" send it to Shopify's plan page.
+ 4. isShopifyBiz()/isShopifyBilling() know about the store from the first load, so other POS
+    options and Stripe stay hidden everywhere, not just after Settings was opened.
+ 5. A website account that logs in with a pending store link lands on the dashboard, where the
+    existing confirm-and-claim step runs (it used to stall in the wizard).
+"""
+import sys
+
+MARK = "/*ct-shopify-nonembedded-v1*/"
+
+PATCHES = [
+    # --- helpers + store lookup ---------------------------------------------------------
+    ("helpers",
+     "function isShopifyBilling(){",
+     MARK + """
+// The Shopify store this account belongs to: an account Clicktide made for a store at install
+// (app_metadata.shopify_shop), or any account with a Shopify store attached.
+var ctShopifyShop="";
+function ctIsShopDomain(s){return /^[a-z0-9][a-z0-9-]*\\.myshopify\\.com$/.test(String(s||""));}
+function shopifyAccountShop(){try{var s=String(S&&S.user&&S.user.app_metadata&&S.user.app_metadata.shopify_shop||"").toLowerCase();return ctIsShopDomain(s)?s:"";}catch(e){return "";}}
+function shopifyStoreOf(biz){
+  var c=[shopifyAccountShop(),biz&&biz.shopify_shop_domain,typeof bizLock!=="undefined"&&bizLock&&bizLock.shopify_shop_domain,ctShopifyShop];
+  for(var i=0;i<c.length;i++){var s=String(c[i]||"").toLowerCase();if(ctIsShopDomain(s))return s;}
+  return "";
+}
+function shopifyPlanUrl(shop){return "https://admin.shopify.com/store/"+encodeURIComponent(String(shop).replace(/\\.myshopify\\.com$/,""))+"/charges/"+SHOPIFY_APP_HANDLE+"/pricing_plans";}
+// Pays through Shopify: a Shopify store and no Stripe subscription of its own (website-first
+// businesses that already pay through Stripe keep Stripe until they pick a Shopify plan).
+function shopifyPaysInShopify(biz){var b=biz||(typeof bizLock!=="undefined"?bizLock:null)||{};if(b.billing_provider==="shopify")return true;if(b.billing_provider==="stripe"||b.stripe_subscription_id)return false;return !!shopifyStoreOf(b);}
+async function loadShopifyStore(tok){
+  if(DEMO||!S||!S.token)return "";
+  try{var r=await fetch(SU+"/rest/v1/platform_connections?select=shop_domain&platform=eq.shopify&is_active=eq.true&"+scope("")+"&order=updated_at.desc&limit=1",{headers:h(tok||S.token)});
+    var rows=await r.json();var s=Array.isArray(rows)&&rows[0]?String(rows[0].shop_domain||"").toLowerCase():"";ctShopifyShop=ctIsShopDomain(s)?s:"";}catch(e){}
+  return ctShopifyShop;
+}
+// Sign-in link from the Shopify admin for a store's own account: same login-CSRF rule as
+// acceptLinkSession (silent only when that account is already signed in here), but the prompt
+// names the store instead of an internal e-mail address.
+async function shopifyLinkOk(u){
+  var cur=S&&S.user,shop=String(u&&u.app_metadata&&u.app_metadata.shopify_shop||"");
+  if(cur&&cur.id&&cur.id===u.id)return true;
+  var m="Open Clicktide for the Shopify store "+shop+"?";
+  if(cur&&cur.email)m+="\\n\\nThis signs "+cur.email+" out on this device.";
+  m+="\\n\\nIf you didn't just open Clicktide from your Shopify admin, choose Cancel.";
+  var ok=await confirmModal({title:"Open Clicktide?",message:m,okText:"Open Clicktide",cancelText:"Cancel"});
+  if(ok)rememberAuthIntent(u.email,"shopify");
+  return ok;
+}
+function goFinishSetup(){
+  var shop=shopifyStoreOf(null);
+  if(shop&&shopifyPaysInShopify(null)){window.location.href=shopifyPlanUrl(shop);return;}
+  resumeOnboarding();
+}
+function isShopifyBilling(){"""),
+
+    ("isShopifyBilling",
+     """    if(typeof bizLock==="undefined"||!bizLock)return false;
+    if(bizLock.billing_provider==="shopify")return true;""",
+     """    if(shopifyAccountShop())return true;
+    if(typeof bizLock==="undefined"||!bizLock)return false;
+    if(bizLock.billing_provider==="shopify")return true;"""),
+
+    ("isShopifyBiz",
+     """  try{return !!((typeof platConn!=="undefined"&&platConn.shopify&&platConn.shopify.merchant_id)||(typeof bizLock!=="undefined"&&bizLock&&bizLock.billing_provider==="shopify"));}catch(e){return false;}""",
+     """  try{return !!((typeof platConn!=="undefined"&&platConn.shopify&&platConn.shopify.merchant_id)||(typeof bizLock!=="undefined"&&bizLock&&bizLock.billing_provider==="shopify")||shopifyStoreOf(null));}catch(e){return false;}"""),
+
+    # --- plan page for unbilled Shopify businesses -------------------------------------
+    ("shopifyBillingUrl",
+     """    if(b.billing_provider==="shopify"&&/^[a-z0-9][a-z0-9-]*\\.myshopify\\.com$/.test(String(b.shopify_shop_domain||""))){""",
+     """    var _ss=shopifyStoreOf(b);
+    if(_ss&&shopifyPaysInShopify(b)&&!(b.billing_provider==="shopify"&&ctIsShopDomain(b.shopify_shop_domain)))return shopifyPlanUrl(_ss);
+    if(b.billing_provider==="shopify"&&/^[a-z0-9][a-z0-9-]*\\.myshopify\\.com$/.test(String(b.shopify_shop_domain||""))){"""),
+
+    ("banner",
+     """<button class="btn btn-gold" style="padding:10px 16px" onclick="resumeOnboarding()">Finish setup</button></div>""",
+     """<button class="btn btn-gold" style="padding:10px 16px" onclick="goFinishSetup()">${shopifyStoreOf(biz)&&shopifyPaysInShopify(biz)?"Choose a plan":"Finish setup"}</button></div>"""),
+
+    ("banner-text",
+     """Your campaigns and gifts switch on the moment your plan is active — finish setting up to start your 30-day free trial.</div>""",
+     """${shopifyStoreOf(biz)&&shopifyPaysInShopify(biz)?"Your campaigns and gifts switch on the moment your plan is active. Choose a plan in Shopify to start your 30-day free trial.":"Your campaigns and gifts switch on the moment your plan is active — finish setting up to start your 30-day free trial."}</div>"""),
+
+    ("requirePaid",
+     """onclick="this.closest('.ov').remove();resumeOnboarding()">Finish setup</button>""",
+     """onclick="this.closest('.ov').remove();goFinishSetup()">${shopifyStoreOf(biz)&&shopifyPaysInShopify(biz)?"Choose a plan":"Finish setup"}</button>"""),
+
+    # --- never strand a Shopify business in the wizard ---------------------------------
+    ("goDashboardOrResume",
+     """  if(hasPaidAccess(biz)){clearOnboardingProgress();if(biz&&biz.onboarding_complete!==true)setBizFields({onboarding_complete:true});go("dash");return;}
+  return resumeOnboarding(biz);""",
+     """  if(hasPaidAccess(biz)){clearOnboardingProgress();if(biz&&biz.onboarding_complete!==true)setBizFields({onboarding_complete:true});go("dash");return;}
+  // Shopify stores (and a store link waiting to be confirmed) use the dashboard; their plan is
+  // chosen in Shopify, and the dashboard runs the store-link confirmation.
+  if(shopifyStoreOf(biz)||pendingShopifyClaim()||await loadShopifyStore()){clearOnboardingProgress();go("dash");return;}
+  return resumeOnboarding(biz);"""),
+
+    ("finishAuthReturn",
+     """  await ensureBizProfile(token,u);
+  const biz=await loadBiz();
+  hydrateOnboardingFromBiz(biz);""",
+     """  await ensureBizProfile(token,u);
+  // A Shopify store's own account (opened from the Shopify admin), or a store link waiting to
+  // be confirmed: straight to the dashboard (no onboarding wizard, no POS welcome e-mail).
+  if(shopifyAccountShop()||pendingShopifyClaim()){clearOnboardingProgress();obAwaitConfirm=false;history.replaceState({view:"dash"},"","/");go("dash");return;}
+  const biz=await loadBiz();
+  hydrateOnboardingFromBiz(biz);"""),
+
+    ("acceptLinkSession",
+     """  if(!u||!u.id)throw new Error("Email confirmed, but Clicktide could not load the account. Please log in.");""",
+     """  // A Shopify store's own account: ask with the store's name (shopifyLinkOk). On yes it marks
+  // this e-mail as expected, so the general check below accepts it without asking again.
+  if(u&&u.id&&ctIsShopDomain(u.app_metadata&&u.app_metadata.shopify_shop)&&!(await shopifyLinkOk(u))){scr=S?"dash":"login";R();return;}
+  if(!u||!u.id)throw new Error("Email confirmed, but Clicktide could not load the account. Please log in.");"""),
+
+    ("ssoArrival",
+     """    const hashToken=hashParams.get("access_token");""",
+     """    // Opened from the Shopify admin: one-time code in the fragment (#ct_sso=…). Clear it from the
+    // address bar at once, then swap it for the store account's session at shopify-sso. The usual
+    // confirmation (shopifyLinkOk) and two-step check still run in finishAuthReturn.
+    const ssoCode=hashParams.get("ct_sso");
+    if(ssoCode){
+      cleanAuthUrl();
+      const sr=await fetch(FN+"/shopify-sso",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({code:ssoCode})});
+      const sd=await sr.json().catch(function(){return {};});
+      if(!sr.ok||!sd.access_token)throw new Error(sd.error||"This sign-in link expired. Open Clicktide from your Shopify admin again.");
+      await finishAuthReturn(sd.access_token,sd.user||null,"magiclink",{refresh_token:sd.refresh_token||"",expires_in:sd.expires_in||"",expires_at:sd.expires_at||""});
+      return;
+    }
+    const hashToken=hashParams.get("access_token");"""),
+
+    ("dLoad",
+     """    bizLock=await loadBiz()||{};
+    const paid=hasPaidAccess(bizLock);""",
+     """    bizLock=await loadBiz()||{};
+    if(!shopifyStoreOf(bizLock))await loadShopifyStore(tok);
+    const paid=hasPaidAccess(bizLock);"""),
+]
+
+
+def main():
+    if len(sys.argv) < 2:
+        sys.exit(__doc__)
+    path, check = sys.argv[1], "--check" in sys.argv
+    s = open(path, encoding="utf-8").read()
+    if MARK in s:
+        print("already applied")
+        return
+    out, problems = s, []
+    for name, old, new in PATCHES:
+        n = out.count(old)
+        if n != 1:
+            problems.append(f"{name}: anchor found {n} times")
+            continue
+        out = out.replace(old, new, 1)
+    if problems:
+        print("NOT APPLIED:\n  " + "\n  ".join(problems))
+        sys.exit(1)
+    if check:
+        print(f"{len(PATCHES)} patch(es) would apply")
+        return
+    open(path, "w", encoding="utf-8").write(out)
+    print(f"applied {len(PATCHES)} patch(es)")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/supabase/functions/_shared/shopify_server.ts b/supabase/functions/_shared/shopify_server.ts
index e096973..6f40516 100644
--- a/supabase/functions/_shared/shopify_server.ts
+++ b/supabase/functions/_shared/shopify_server.ts
@@ -278,3 +278,125 @@ async function reportUsageLeased(limit: number) {
   }
   return out;
 }
+
+// ---- Shopify sign-in (non-embedded app, App Store 2.3.x and "seamless sign up") ----
+// A store installed from Shopify gets its own Clicktide account, created here (no password,
+// no e-mail round trip). Opening the app from the Shopify admin then signs that account in
+// with a one-time link. Accounts that were made on the website and linked to a store by the
+// owner (claim flow) are never signed in this way: those owners log in themselves.
+export const APP_BASE_URL = Deno.env.get("APP_BASE_URL") ?? "https://goclicktide.com";
+// A domain Clicktide controls and never receives mail at: nobody can pre-register or read these.
+export const PROVISION_EMAIL_DOMAIN = "shopify-users.goclicktide.com";
+
+async function authAdmin(path: string, init: RequestInit = {}) {
+  const r = await fetch(`${SUPA}/auth/v1/admin${path}`, {
+    ...init,
+    headers: { apikey: SRK, Authorization: `Bearer ${SRK}`, "Content-Type": "application/json", ...(init.headers || {}) },
+  });
+  const d = await r.json().catch(() => ({}));
+  return { ok: r.ok, status: r.status, data: d as Record<string, any> };
+}
+
+function randHex(n: number) {
+  return Array.from(crypto.getRandomValues(new Uint8Array(n)), (b) => b.toString(16).padStart(2, "0")).join("");
+}
+
+// The Clicktide account Clicktide created for exactly this store?
+export async function provisionedFor(userId: string, shop: string): Promise<boolean> {
+  const u = await authAdmin(`/users/${encodeURIComponent(userId)}`);
+  return u.ok && String(u.data?.app_metadata?.shopify_shop || "").toLowerCase() === shop.toLowerCase();
+}
+
+// Where to send the merchant: goclicktide.com/#ct_sso=<one-time code>. The code is in the URL
+// fragment (never sent to a server or logged), lives 60 seconds, is single use and bound to the
+// account and shop (clicktide_shopify_sso_mint; refused for staff or without an active store
+// connection). The page swaps it for a session at shopify-sso.
+export async function ssoUrlFor(userId: string, shop: string): Promise<string | null> {
+  if (!(await provisionedFor(userId, shop))) return null;
+  const code = await rpc("clicktide_shopify_sso_mint", { p_user: userId, p_shop: shop });
+  if (typeof code !== "string" || !/^[0-9a-f]{64}$/.test(code)) return null;
+  return `${APP_BASE_URL}/#ct_sso=${code}`;
+}
+
+// shopify-sso: one-time code -> session for the store's own account, created server-side.
+export async function sessionForSsoCode(code: string): Promise<Record<string, unknown> | null> {
+  const t = await rpc("clicktide_shopify_sso_take", { p_code: code }) as Record<string, any>;
+  if (!t?.ok) return null;
+  const userId = String(t.user_id), shop = String(t.shop);
+  const u = await authAdmin(`/users/${encodeURIComponent(userId)}`);
+  const email = String(u.data?.email || "");
+  if (!u.ok || !email || String(u.data?.app_metadata?.shopify_shop || "").toLowerCase() !== shop) return null;
+  const g = await authAdmin("/generate_link", { method: "POST", body: JSON.stringify({ type: "magiclink", email }) });
+  const hashed = String(g.data?.hashed_token || g.data?.properties?.hashed_token || "");
+  if (!g.ok || !hashed) { console.error("shopify sso link failed", shop, g.status); return null; }
+  const v = await fetch(`${SUPA}/auth/v1/verify`, {
+    method: "POST", headers: { apikey: SRK, "Content-Type": "application/json" },
+    body: JSON.stringify({ type: "magiclink", token_hash: hashed }),
+  });
+  const sess = await v.json().catch(() => ({})) as Record<string, any>;
+  if (!v.ok || !sess?.access_token) { console.error("shopify sso verify failed", shop, v.status); return null; }
+  return { access_token: sess.access_token, refresh_token: sess.refresh_token, expires_in: sess.expires_in, expires_at: sess.expires_at, user: sess.user, shop };
+}
+
+async function shopProfile(shop: string, token: string) {
+  try {
+    const r = await fetch(`https://${shop}/admin/api/${SHOPIFY_API_VERSION}/graphql.json`, {
+      method: "POST", headers: { "X-Shopify-Access-Token": token, "Content-Type": "application/json" },
+      body: JSON.stringify({ query: "{ shop { name contactEmail email ianaTimezone } }" }),
+    });
+    const s = (await r.json().catch(() => ({})))?.data?.shop;
+    if (s) return { name: String(s.name || "").replace(/[<>]/g, "").slice(0, 120), email: String(s.contactEmail || s.email || "").slice(0, 200), tz: String(s.ianaTimezone || "") };
+  } catch (e) { console.error("shop profile lookup failed", shop, e); }
+  return { name: "", email: "", tz: "" };
+}
+
+export type ClaimResult =
+  | { ok: true; userId: string; shop: string; created: boolean }
+  | { ok: false; reason: "expired" | "website_account" | "failed"; shop?: string };
+
+// Install from Shopify finished (claim token in hand): attach the store to the Clicktide
+// account Clicktide made for it before (reinstall), or make that account now. A store owned
+// by a website account is left for its owner to claim after logging in.
+export async function provisionForClaim(claim: string): Promise<ClaimResult> {
+  const hash = await sha256Hex(claim);
+  const info = await rpc("clicktide_shopify_claim_info", { p_token_hash: hash }) as Record<string, any>;
+  if (!info?.ok) return { ok: false, reason: "expired" };
+  const shop = String(info.shop_domain || "").toLowerCase();
+  const owner = info.owner ? String(info.owner) : "";
+  if (owner) {
+    if (!(await provisionedFor(owner, shop))) return { ok: false, reason: "website_account", shop };
+    const r = await rpc("clicktide_shopify_claim", { p_token_hash: hash, p_user: owner }) as Record<string, any>;
+    return r?.ok ? { ok: true, userId: owner, shop, created: false } : { ok: false, reason: "failed", shop };
+  }
+  // New store: create its account and business profile, then claim.
+  const rows = await rest(`/rest/v1/shopify_install_claims?token_hash=eq.${hash}&select=connection_id&limit=1`) as Array<{ connection_id: string }>;
+  const conn = rows?.[0] ? (await rest(`/rest/v1/platform_connections?id=eq.${rows[0].connection_id}&select=access_token,merchant_name&limit=1`) as Array<{ access_token: string; merchant_name: string }>)?.[0] : null;
+  const prof = conn?.access_token ? await shopProfile(shop, conn.access_token) : { name: "", email: "", tz: "" };
+  const name = prof.name || conn?.merchant_name || shop.replace(/\.myshopify\.com$/, "");
+  const slug = shop.replace(/\.myshopify\.com$/, "").slice(0, 50);
+  let email = `${slug}@${PROVISION_EMAIL_DOMAIN}`;
+  const create = () => authAdmin("/users", {
+    method: "POST",
+    body: JSON.stringify({ email, email_confirm: true, app_metadata: { shopify_shop: shop, signup: "shopify" }, user_metadata: { business_name: name } }),
+  });
+  let cu = await create();
+  if (!cu.ok && (cu.status === 422 || cu.status === 409)) { email = `${slug}-${randHex(3)}@${PROVISION_EMAIL_DOMAIN}`; cu = await create(); }
+  const userId = String(cu.data?.id || "");
+  if (!cu.ok || !userId) { console.error("shopify account create failed", shop, cu.status, JSON.stringify(cu.data).slice(0, 200)); return { ok: false, reason: "failed", shop }; }
+  try {
+    await rest("/rest/v1/clicktide", {
+      method: "POST", headers: { Prefer: "return=minimal" },
+      // Owner alerts and receipts go to the store's contact address from Shopify, never the
+      // internal sign-in address.
+      body: JSON.stringify({ user_id: userId, business_name: name, email: prof.email || null, business_email: prof.email || null, onboarding_complete: true, business_type: "other", churn_days: 60 }),
+    });
+    const r = await rpc("clicktide_shopify_claim", { p_token_hash: hash, p_user: userId }) as Record<string, any>;
+    if (!r?.ok) throw new Error(`claim ${r?.error || "failed"}`);
+    return { ok: true, userId, shop, created: true };
+  } catch (e) {
+    console.error("shopify account setup failed; removing the half-made account", shop, e);
+    await rest(`/rest/v1/clicktide?user_id=eq.${userId}`, { method: "DELETE" }).catch(() => {});
+    await authAdmin(`/users/${userId}`, { method: "DELETE" }).catch(() => {});
+    return { ok: false, reason: "failed", shop };
+  }
+}
