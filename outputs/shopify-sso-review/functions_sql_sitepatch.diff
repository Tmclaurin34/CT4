+  values (gen_random_uuid(), null, 'shopify', 'second-dev.myshopify.com', true, 'tok2', '999111222', 'Second') returning id into c1;
+  insert into shopify_install_claims (token_hash, connection_id, shop_domain) values ('h1', c1, 'second-dev.myshopify.com');
+
+  -- 1. info: valid claim, no owner yet
+  i := clicktide_shopify_claim_info('h1');
+  if (i->>'ok')::boolean is not true or i->>'shop_domain' <> 'second-dev.myshopify.com' or i->>'owner' is not null then raise exception 'FAIL 1: %', i; end if;
+  -- 2. an account that already has another store is refused, claim NOT consumed
+  r := clicktide_shopify_claim('h1', u);
+  if r->>'error' is distinct from 'other_store' or r->>'other_shop' <> 'clicktide-test.myshopify.com' then raise exception 'FAIL 2: %', r; end if;
+  if not exists (select 1 from shopify_install_claims where token_hash = 'h1' and claimed_at is null) then raise exception 'FAIL 2b: claim consumed'; end if;
+  -- 3. a fresh account can claim it
+  insert into auth.users(id, email, aud, role) values (other, 'one-store-test@example.test', 'authenticated', 'authenticated');
+  r := clicktide_shopify_claim('h1', other);
+  if (r->>'ok')::boolean is not true then raise exception 'FAIL 3: %', r; end if;
+  -- 4. info for clicktide-test's store via a new unclaimed row: owner = u (reinstall path)
+  insert into platform_connections (id, user_id, platform, shop_domain, is_active, access_token, merchant_id)
+  values (gen_random_uuid(), null, 'shopify', 'clicktide-test.myshopify.com', false, '', '81761337561') returning id into c1;
+  insert into shopify_install_claims (token_hash, connection_id, shop_domain) values ('h2', c1, 'clicktide-test.myshopify.com');
+  i := clicktide_shopify_claim_info('h2');
+  if (i->>'owner')::uuid is distinct from u then raise exception 'FAIL 4: %', i; end if;
+  -- 5. unknown claim
+  if (clicktide_shopify_claim_info('nope')->>'ok')::boolean is not false then raise exception 'FAIL 5'; end if;
+  raise exception 'ALL ONE-STORE TESTS PASSED';
+end $t$;
diff --git a/supabase/tests/shopify_sso_codes_test.sql b/supabase/tests/shopify_sso_codes_test.sql
new file mode 100644
index 0000000..f82d224
--- /dev/null
+++ b/supabase/tests/shopify_sso_codes_test.sql
@@ -0,0 +1,39 @@
+-- SSO codes. Run with 20261128180200 in one rolled-back transaction.
+do $t$
+declare
+  u uuid := '675f5e6d-2de0-43e3-91f9-8126b5e6967a';  -- active clicktide-test connection
+  shop text := 'clicktide-test.myshopify.com';
+  code text; r jsonb; staff_had boolean;
+begin
+  select exists(select 1 from clicktide_staff where user_id = u and coalesce(is_active, true)) into staff_had;
+  if staff_had then
+    -- 1. staff accounts never get a code
+    if clicktide_shopify_sso_mint(u, shop) is not null then raise exception 'FAIL 1: staff got a code'; end if;
+    delete from clicktide_staff where user_id = u;   -- rolled back
+  end if;
+  -- 1b. make it staff (rolled back): no code
+  insert into clicktide_staff(user_id, role, is_active) values (u, 'support', true) on conflict (user_id) do update set is_active = true;
+  if clicktide_shopify_sso_mint(u, shop) is not null then raise exception 'FAIL 1b: staff got a code'; end if;
+  delete from clicktide_staff where user_id = u;
+  -- 2. wrong shop: no code
+  if clicktide_shopify_sso_mint(u, 'other.myshopify.com') is not null then raise exception 'FAIL 2'; end if;
+  -- 3. mint + take once
+  code := clicktide_shopify_sso_mint(u, shop);
+  if code !~ '^[0-9a-f]{64}$' then raise exception 'FAIL 3a: %', code; end if;
+  if exists (select 1 from shopify_sso_codes where code_hash = code) then raise exception 'FAIL 3b: stored in clear'; end if;
+  r := clicktide_shopify_sso_take(code);
+  if (r->>'ok')::boolean is not true or (r->>'user_id')::uuid <> u or r->>'shop' <> shop then raise exception 'FAIL 3c: %', r; end if;
+  -- 4. replay refused
+  if (clicktide_shopify_sso_take(code)->>'ok')::boolean then raise exception 'FAIL 4: replay'; end if;
+  -- 5. expired refused
+  code := clicktide_shopify_sso_mint(u, shop);
+  update shopify_sso_codes set expires_at = now() - interval '1 second';
+  if (clicktide_shopify_sso_take(code)->>'ok')::boolean then raise exception 'FAIL 5: expired'; end if;
+  -- 6. connection deactivated between mint and take: refused
+  code := clicktide_shopify_sso_mint(u, shop);
+  update platform_connections set is_active = false where user_id = u and platform = 'shopify';
+  if (clicktide_shopify_sso_take(code)->>'ok')::boolean then raise exception 'FAIL 6: inactive store'; end if;
+  -- 7. junk
+  if (clicktide_shopify_sso_take('xyz')->>'ok')::boolean then raise exception 'FAIL 7'; end if;
+  raise exception 'ALL SSO CODE TESTS PASSED (staff case tested: %)', staff_had;
+end $t$;
